{
  "name": "@cynthion/aicon-studio",
  "version": "0.0.0",
  "description": "Draws candidate icon sets with an image model, compares them and adopts one into your project.",
  "license": "GPL-2.0-only",
  "author": "Christian Lüthold",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cynthion/aicon-studio.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aicon-studio": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "ng build && node src/cli.ts example",
    "watch": "ng build --watch --configuration development",
    "build": "tsc -p tsconfig.build.json && ng build",
    "test": "vitest run && ng test --no-watch",
    "lint": "eslint .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "docs:lint": "markdownlint-cli2",
    "worktree:add": "bash scripts/worktree-add.sh"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "potrace": "2.1.8"
  },
  "devDependencies": {
    "@angular/aria": "22.2.4",
    "@angular/build": "22.2.4",
    "@angular/cdk": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@cynthion/ngx-formidable": "1.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "angular-eslint": "22.6.0",
    "date-fns": "4.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-rxjs-x": "1.0.6",
    "jsdom": "30.1.3",
    "markdownlint-cli2": "0.24.0",
    "markdownlint-rule-relative-links": "5.1.4",
    "ngx-mask": "22.2.5",
    "pikaday": "1.8.2",
    "prettier": "3.9.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
